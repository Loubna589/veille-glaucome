# Modèle de configuration. Copiez ce fichier en « .env » et remplissez-le.
# Le fichier .env est ignoré par Git : il ne sera jamais publié.
# Toutes les valeurs sont FACULTATIVES : l'outil fonctionne sans.
# Sur GitHub Actions, ces valeurs seront des « secrets » du dépôt.

# Adresse de contact transmise poliment aux API (PubMed, OpenAlex)
CONTACT_EMAIL=

# Clé NCBI gratuite : passe PubMed de 3 à 10 requêtes par seconde
NCBI_API_KEY=

# Clé OpenAlex, si un quota plus élevé devient nécessaire
OPENALEX_API_KEY=

# Assistant RAG et IA en local (GitHub Models, gratuit) : jeton GitHub « fine-grained » avec la permission
# « Models : Read-only ». Créez-le vous-même sur github.com ; ne le partagez jamais.
GITHUB_TOKEN=

# Australie : API publique du PBS (remboursement). Le portail du ministère australien publie une clé partagée
# pour les utilisateurs publics non inscrits : https://data-api-portal.health.gov.au/apis (copiez-la ici vous-même).
PBS_API_KEY=
